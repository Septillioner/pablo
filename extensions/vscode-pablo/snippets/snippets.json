    "Pablo: Verified Transfer": {
        "prefix": "pablo-tpl-verified-transfer",
        "body": [
            "name: \"${1:verified-site}\"",
            "version: \"2.0.0\"",
            "",
            "credentials:",
            "  ${5:deploy-ssh}:",
