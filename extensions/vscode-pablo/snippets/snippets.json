{
    "Pablo Config (Empty)": {
        "prefix": "pablo-config",
        "body": [
            "name: \"${1:project-name}\"",
            "version: \"2.0.0\"",
            "",
            "profiles:",
            "  ${2:profile-name}:",
            "    type: ${3|static,binary,docker,git-sync|}",
            "    environments:",
            "      ${4:env-name}:",
            "        deploy:",
            "          source:",
            "            dir: \"${5:./dist}\"",
            "          target_path: \"${6:/var/www/app}\"",
            "          strategy: ${7|overwrite,backup,recreate,rename-replace|}"
        ],
        "description": "Basic Pablo Schema v2 configuration skeleton"
    },
    "Pablo: Static Site (Overwrite)": {
        "prefix": "pablo-tpl-static-site",
        "body": [
            "name: \"${1:my-static-site}\"",
            "version: \"2.0.0\"",
            "",
            "credentials:",
            "  ${5:deploy-ssh}:",
            "    type: ssh",
            "    username: ${6:deploy}",
            "    key: \"${7:~/.ssh/id_rsa}\"",
            "",
            "profiles:",
            "  web:",
            "    type: static",
            "    environments:",
            "      production:",
            "        remote:",
            "          host: \"${4:example.com}\"",
            "          credential: \"${5:deploy-ssh}\"",
            "        deploy:",
            "          source:",
            "            dir: \"${2:./dist}\"",
            "            include: [\"**/*\"]",
            "            exclude: [\"*.map\"]",
            "          target_path: \"${3:/var/www/html}\"",
            "          strategy: overwrite"
        ],
        "description": "Static site deploy over SSH with overwrite strategy"
    },
    "Pablo: Static Hotfix (Rename-Replace)": {
        "prefix": "pablo-tpl-static-hotfix",
        "body": [
            "name: \"${1:my-static-hotfix}\"",
            "version: \"2.0.0\"",
            "",
            "credentials:",
            "  ${5:deploy-ssh}:",
            "    type: ssh",
            "    username: ${6:deploy}",
            "    key: \"${7:~/.ssh/id_rsa}\"",
            "",
            "profiles:",
            "  web:",
            "    type: static",
            "    environments:",
            "      production:",
            "        remote:",
            "          host: \"${4:example.com}\"",
            "          credential: \"${5:deploy-ssh}\"",
            "        deploy:",
            "          source:",
            "            dir: \"${2:./dist}\"",
            "            include: [\"**/*\"]",
            "            exclude: [\"*.map\"]",
            "          target_path: \"${3:/var/www/html}\"",
            "          strategy: rename-replace"
        ],
        "description": "Static site hotfix using rename-replace strategy"
    },
    "Pablo: Go / Binary Service": {
        "prefix": "pablo-tpl-go-service",
        "body": [
            "name: \"${1:go-service}\"",
            "version: \"2.0.0\"",
            "",
            "credentials:",
            "  ${6:deploy-ssh}:",
            "    type: ssh",
            "    username: ${7:deploy}",
            "    key: \"${8:~/.ssh/id_rsa}\"",
            "",
            "profiles:",
            "  default:",
            "    type: binary",
            "    build:",
            "      path: \"${2:./src}\"",
            "      command: \"GOOS=linux GOARCH=amd64 go build -o ../dist/${1:go-service} .\"",
            "    environments:",
            "      production:",
            "        remote:",
            "          host: \"${5:example.com}\"",
            "          credential: \"${6:deploy-ssh}\"",
            "        deploy:",
            "          source:",
            "            dir: \"./dist\"",
            "            include: [\"${1:go-service}\"]",
            "          target_path: \"${3:/opt/go-service}\"",
            "          strategy: backup",
            "          post_commands:",
            "            - \"chmod +x $3/${1:go-service}\"",
            "            - \"systemctl restart ${4:go-service}\""
        ],
        "description": "Go/binary service with build, backup strategy, and post_commands"
    },
    "Pablo: Docker Compose": {
        "prefix": "pablo-tpl-compose",
        "body": [
            "name: \"${1:compose-api}\"",
            "version: \"2.0.0\"",
            "",
            "credentials:",
            "  ${5:deploy-ssh}:",
            "    type: ssh",
            "    username: ${6:deploy}",
            "    key: \"${7:~/.ssh/id_rsa}\"",
            "",
            "profiles:",
            "  default:",
            "    type: docker",
            "    git:",
            "      repo: \"${2:git@github.com:org/compose-api.git}\"",
            "      branch: \"${3:main}\"",
            "    environments:",
            "      production:",
            "        remote:",
            "          host: \"${4:example.com}\"",
            "          credential: \"${5:deploy-ssh}\"",
            "        deploy:",
            "          target_path: \"${8:/opt/compose-api}\"",
            "          docker:",
            "            compose_file: \"${9:docker-compose.yml}\"",
            "            build: false",
            "            stop_before_sync: true"
        ],
        "description": "Docker Compose deploy over SSH (git + deploy.docker)"
    },
    "Pablo: PHP / Git-Sync": {
        "prefix": "pablo-tpl-php-app",
        "body": [
            "name: \"${1:php-app}\"",
            "version: \"2.0.0\"",
            "",
            "credentials:",
            "  ${6:deploy-ssh}:",
            "    type: ssh",
            "    username: ${7:deploy}",
            "    key: \"${8:~/.ssh/id_rsa}\"",
            "",
            "profiles:",
            "  default:",
            "    type: git-sync",
            "    variables:",
            "      APP_ENV: production",
            "      APP_DEBUG: \"false\"",
            "    env_file: \"${2:.env}\"",
            "    git:",
            "      repo: \"${3:git@github.com:org/php-app.git}\"",
            "      branch: \"${4:main}\"",
            "    environments:",
            "      production:",
            "        remote:",
            "          host: \"${5:example.com}\"",
            "          credential: \"${6:deploy-ssh}\"",
            "        deploy:",
            "          target_path: \"${9:/var/www/php-app}\"",
            "          strategy: overwrite",
            "          post_commands:",
            "            - \"composer install --no-dev --working-dir=$9\"",
            "            - \"php $9/artisan migrate --force\""
        ],
        "description": "PHP git-sync deploy with env_file, variables, and post_commands"
    },
    "Pablo: Release Sequence": {
        "prefix": "pablo-tpl-sequence",
        "body": [
            "name: \"${1:release-web}\"",
            "version: \"2.0.0\"",
            "",
            "credentials:",
            "  ${6:deploy-ssh}:",
            "    type: ssh",
            "    username: ${7:deploy}",
            "    key: \"${8:~/.ssh/id_rsa}\"",
            "",
            "sequences:",
            "  release:",
            "    - web/staging",
            "    - web/production",
            "",
            "profiles:",
            "  web:",
            "    type: static",
            "    environments:",
            "      staging:",
            "        remote:",
            "          host: \"${4:staging.example.com}\"",
            "          credential: \"${6:deploy-ssh}\"",
            "        deploy:",
            "          source:",
            "            dir: \"${2:./dist}\"",
            "            include: [\"**/*\"]",
            "            exclude: [\"*.map\"]",
            "          target_path: \"${3:/var/www/app-staging}\"",
            "          strategy: overwrite",
            "      production:",
            "        remote:",
            "          host: \"${5:example.com}\"",
            "          credential: \"${6:deploy-ssh}\"",
            "        deploy:",
            "          source:",
            "            dir: \"${2:./dist}\"",
            "            include: [\"**/*\"]",
            "            exclude: [\"*.map\"]",
            "          target_path: \"${9:/var/www/app}\"",
            "          strategy: overwrite"
        ],
        "description": "Staging then production release sequence for a static site"
    },
    "Pablo: Site with Backup": {
