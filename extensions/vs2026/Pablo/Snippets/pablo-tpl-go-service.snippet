<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Pablo: Go / Binary Service</Title>
      <Shortcut>pablo-tpl-go-service</Shortcut>
      <Description>Binary deploy with build, backup strategy, and post_commands</Description>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Code Language="yaml"><![CDATA[name: "$1"
version: "2.0.0"

credentials:
  $2:
    type: ssh
    username: deploy
    key: "~/.ssh/id_rsa"

profiles:
  default:
    type: binary
    build:
      path: "./src"
      command: "GOOS=linux GOARCH=amd64 go build -o ../dist/$3 ."
    environments:
      production:
        remote:
          host: "$4"
          credential: "$2"
        deploy:
          source:
            dir: "./dist"
            include: ["$3"]
          target_path: "$5"
          strategy: backup
          post_commands:
            - "chmod +x $5/$3"
            - "systemctl restart $3"]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
