<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Pablo: Node.js + PM2 Template</Title>
      <Shortcut>pablo-tpl-node-pm2</Shortcut>
      <Description>Ready-to-use template for Node.js apps managed by PM2</Description>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Code Language="yaml"><![CDATA[name: "$1"
version: "1.4.0"
credentials:
  $2:
    type: ssh
    key: "~/.ssh/id_rsa"

profiles:
  api-server:
    type: binary
    build:
      command: "npm install && npm run build"
    output_dir:
      dir: "dist"
    environments:
      prod:
        target_path: "$3"
        strategy: backup
        remote:
          method: ssh
          host: "$4"
          credential: "$2"
        deploy:
          service:
            type: pm2
            name: "$1"
            restart: true]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
