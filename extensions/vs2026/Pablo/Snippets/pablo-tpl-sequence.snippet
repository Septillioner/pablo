<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Pablo: Release Sequence</Title>
      <Shortcut>pablo-tpl-sequence</Shortcut>
      <Description>Staging then production release sequence for a static site</Description>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Code Language="yaml"><![CDATA[name: "$1"
version: "2.0.0"

credentials:
  $2:
    type: ssh
    username: deploy
    key: "~/.ssh/id_rsa"

sequences:
  release:
    - web/staging
    - web/production

profiles:
  web:
    type: static
    environments:
      staging:
        remote:
          host: "$3"
          credential: "$2"
        deploy:
          source:
            dir: "$4"
            include: ["**/*"]
            exclude: ["*.map"]
          target_path: "$5"
          strategy: overwrite
      production:
        remote:
          host: "$6"
          credential: "$2"
        deploy:
          source:
            dir: "$4"
            include: ["**/*"]
            exclude: ["*.map"]
          target_path: "$7"
          strategy: overwrite]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
