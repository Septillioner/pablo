<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Pablo: Docker Compose Template</Title>
      <Shortcut>pablo-tpl-docker</Shortcut>
      <Description>Ready-to-use template for Docker Compose deployments</Description>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Code Language="yaml"><![CDATA[name: "$1"
version: "1.4.0"

profiles:
  app-stack:
    type: docker
    git:
      repo: "$2"
      branch: "main"
    environments:
      swarm-cluster:
        target_path: "$3"
        deploy:
          docker:
            compose_file: "docker-compose.prod.yml"
            build: true
            command: "up -d"]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
