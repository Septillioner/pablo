<?xml version="1.0" encoding="utf-8"?>

<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">



  <Extern href="stdidcmd.h"/>

  <Extern href="vsshlids.h"/>



  <Commands package="guidPabloPkg">

    <Menus>

      <Menu guid="guidPabloCmdSet" id="PabloToolbar" type="Toolbar" priority="0x0100">

        <CommandFlag>DefaultDocked</CommandFlag>

        <Strings>

          <ButtonText>Pablo</ButtonText>

          <CommandName>Pablo.Toolbar</CommandName>

        </Strings>

      </Menu>

    </Menus>



    <Groups>

      <Group guid="guidPabloCmdSet" id="grpPabloTools" priority="0x0600">

        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_TOOLS"/>

      </Group>

      <Group guid="guidPabloCmdSet" id="grpPabloEditor" priority="0x0600">

        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_CODEWIN"/>

      </Group>

      <Group guid="guidPabloCmdSet" id="grpHidden" priority="0x0600">

        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_TOOLS"/>

      </Group>

      <Group guid="guidPabloCmdSet" id="grpPabloToolbar" priority="0x0100">

        <Parent guid="guidPabloCmdSet" id="PabloToolbar"/>

      </Group>

    </Groups>



    <Combos>

      <Combo guid="guidPabloCmdSet" id="cmdidYamlCombo" priority="0x0100" type="DropDownCombo" idCommandList="cmdidYamlComboGetList" defaultWidth="48" width="48">

        <Parent guid="guidPabloCmdSet" id="grpPabloToolbar"/>

        <Strings>

          <ButtonText>Manifest</ButtonText>

          <CommandName>Pablo.YamlCombo</CommandName>

        </Strings>

      </Combo>

      <Combo guid="guidPabloCmdSet" id="cmdidProfileCombo" priority="0x0101" type="DropDownCombo" idCommandList="cmdidProfileComboGetList" defaultWidth="20" width="20">

        <Parent guid="guidPabloCmdSet" id="grpPabloToolbar"/>

        <Strings>

          <ButtonText>Profile</ButtonText>

          <CommandName>Pablo.ProfileCombo</CommandName>

        </Strings>

      </Combo>

      <Combo guid="guidPabloCmdSet" id="cmdidEnvCombo" priority="0x0102" type="DropDownCombo" idCommandList="cmdidEnvComboGetList" defaultWidth="16" width="16">

        <Parent guid="guidPabloCmdSet" id="grpPabloToolbar"/>

        <Strings>

          <ButtonText>Environment</ButtonText>

          <CommandName>Pablo.EnvCombo</CommandName>

        </Strings>

      </Combo>

    </Combos>



    <Buttons>

      <Button guid="guidPabloCmdSet" id="cmdidCheck" priority="0x0100" type="Button">

        <Parent guid="guidPabloCmdSet" id="grpPabloTools"/>

        <Strings>

          <ButtonText>Pablo: Check YAML</ButtonText>

          <CommandName>Pablo.Check</CommandName>

        </Strings>

      </Button>

      <Button guid="guidPabloCmdSet" id="cmdidInit" priority="0x0101" type="Button">

        <Parent guid="guidPabloCmdSet" id="grpPabloTools"/>

        <Strings>

          <ButtonText>Pablo: Init Config</ButtonText>

          <CommandName>Pablo.Init</CommandName>

        </Strings>

      </Button>

      <Button guid="guidPabloCmdSet" id="cmdidRun" priority="0x0102" type="Button">

        <Parent guid="guidPabloCmdSet" id="grpPabloTools"/>

        <Strings>

          <ButtonText>Pablo: Run Deployment</ButtonText>

          <CommandName>Pablo.Run</CommandName>

        </Strings>

      </Button>

      <Button guid="guidPabloCmdSet" id="cmdidSelectExecutable" priority="0x0103" type="Button">

        <Parent guid="guidPabloCmdSet" id="grpPabloTools"/>

        <Strings>

          <ButtonText>Pablo: Select Executable</ButtonText>

          <CommandName>Pablo.SelectExecutable</CommandName>

        </Strings>

      </Button>

      <Button guid="guidPabloCmdSet" id="cmdidUpdate" priority="0x0104" type="Button">

        <Parent guid="guidPabloCmdSet" id="grpPabloTools"/>

        <Strings>

          <ButtonText>Pablo: Update</ButtonText>

          <CommandName>Pablo.Update</CommandName>

        </Strings>

      </Button>

      <Button guid="guidPabloCmdSet" id="cmdidToolbarRun" priority="0x0103" type="Button">

        <Parent guid="guidPabloCmdSet" id="grpPabloToolbar"/>

        <Icon guid="guidImages" id="bmpLogo"/>

        <CommandFlag>IconAndText</CommandFlag>

        <Strings>

          <ButtonText>Run</ButtonText>

          <CommandName>Pablo.ToolbarRun</CommandName>

        </Strings>

      </Button>

      <Button guid="guidPabloCmdSet" id="cmdidYamlComboGetList" priority="0x0104" type="Button">

        <Parent guid="guidPabloCmdSet" id="grpHidden"/>

        <CommandFlag>DefaultInvisible</CommandFlag>

        <CommandFlag>DefaultDisabled</CommandFlag>

        <Strings>

          <ButtonText>Yaml Combo List</ButtonText>

          <CommandName>Pablo.YamlComboGetList</CommandName>

        </Strings>

      </Button>

      <Button guid="guidPabloCmdSet" id="cmdidProfileComboGetList" priority="0x0105" type="Button">

        <Parent guid="guidPabloCmdSet" id="grpHidden"/>

        <CommandFlag>DefaultInvisible</CommandFlag>

        <CommandFlag>DefaultDisabled</CommandFlag>

        <Strings>

          <ButtonText>Profile Combo List</ButtonText>

          <CommandName>Pablo.ProfileComboGetList</CommandName>

        </Strings>

      </Button>

      <Button guid="guidPabloCmdSet" id="cmdidEnvComboGetList" priority="0x0106" type="Button">

        <Parent guid="guidPabloCmdSet" id="grpHidden"/>

        <CommandFlag>DefaultInvisible</CommandFlag>

        <CommandFlag>DefaultDisabled</CommandFlag>

        <Strings>

          <ButtonText>Environment Combo List</ButtonText>

          <CommandName>Pablo.EnvComboGetList</CommandName>

        </Strings>

      </Button>

      <Button guid="guidPabloCmdSet" id="cmdidRunWithArgs" priority="0x0107" type="Button">

        <Parent guid="guidPabloCmdSet" id="grpHidden"/>

        <CommandFlag>DefaultInvisible</CommandFlag>

        <CommandFlag>DefaultDisabled</CommandFlag>

        <Strings>

          <ButtonText>Run With Profile/Env</ButtonText>

          <CommandName>pablo.runWithArgs</CommandName>

        </Strings>

      </Button>

    </Buttons>



    <Bitmaps>

      <Bitmap guid="guidImages" href="..\Resources\logo.png" usedList="bmpLogo"/>

    </Bitmaps>

  </Commands>



