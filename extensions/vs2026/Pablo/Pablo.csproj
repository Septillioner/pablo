<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>Pablo.VisualStudio</RootNamespace>
    <AssemblyName>Pablo.VisualStudio</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <UseCodebase>true</UseCodebase>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>false</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>true</CopyOutputSymbolsToOutputDirectory>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <CreateVsixContainer>true</CreateVsixContainer>
    <!-- Debug F5 deploys into Experimental Instance; Release packaging skips Exp deploy. -->
    <DeployExtension Condition="'$(Configuration)' == 'Debug'">true</DeployExtension>
    <DeployExtension Condition="'$(Configuration)' != 'Debug'">false</DeployExtension>
    <VSSDKTargetPlatformRegRootSuffix>Exp</VSSDKTargetPlatformRegRootSuffix>
    <!-- SDK-style: VSSDK evaluates these before IntermediateOutputPath is ready; pin absolute obj paths. -->
    <_VsixIntermediateOutputPath>$(MSBuildProjectDirectory)\obj\$(Configuration)\$(TargetFramework)\</_VsixIntermediateOutputPath>
    <FileManifest>$(_VsixIntermediateOutputPath)files.json</FileManifest>
    <TemplateFileManifest>$(_VsixIntermediateOutputPath)templateFiles.json</TemplateFileManifest>
    <ResourceManifest>$(_VsixIntermediateOutputPath)resources.json</ResourceManifest>
    <CtoFileManifest>$(_VsixIntermediateOutputPath)ctoFiles.json</CtoFileManifest>
    <CtoCacheFile>$(_VsixIntermediateOutputPath)mergeCto.cache</CtoCacheFile>
    <CreateTemplateManifestsCacheFile>$(_VsixIntermediateOutputPath)createTemplateManifests.cache</CreateTemplateManifestsCacheFile>
    <TemplateOutputDirectory>$(_VsixIntermediateOutputPath)</TemplateOutputDirectory>
    <CreatePkgDefAssemblyToProcess>$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).dll</CreatePkgDefAssemblyToProcess>
    <TargetVsixContainer>$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).vsix</TargetVsixContainer>
  </PropertyGroup>

  <PropertyGroup>
    <StartAction>Program</StartAction>
    <StartProgram Condition="'$(DevEnvDir)' != ''">$(DevEnvDir)devenv.exe</StartProgram>
    <StartProgram Condition="'$(DevEnvDir)' == ''">C:\Program Files\Microsoft Visual Studio\18\Insiders\Common7\IDE\devenv.exe</StartProgram>
    <StartArguments>/rootsuffix Exp</StartArguments>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.12.40392" ExcludeAssets="runtime" />
    <!-- Host VS supplies these at runtime; shipping them breaks MEF type identity. -->
    <PackageReference Include="Microsoft.VisualStudio.LanguageServer.Client" Version="17.12.48" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.13.2126">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" ExcludeAssets="runtime" />
    <PackageReference Include="StreamJsonRpc" Version="2.20.17" ExcludeAssets="runtime" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Design" />
    <Reference Include="System.Xaml" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <ItemGroup>
    <None Include="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </None>
    <None Remove="extension.vsixmanifest" />
    <Content Include="Snippets\**\*.snippet">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="Resources\logo.png">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <VSCTCompile Include="PabloVsct\PabloCommands.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
  </ItemGroup>

  <!-- When CreateVsixContainer is up-to-date/skipped, _CreatedVsixContainer is empty and Unzip fails. -->
  <Target Name="EnsureCreatedVsixContainer" BeforeTargets="DeployVsixExtensionFiles" DependsOnTargets="CreateVsixContainer">
    <ItemGroup Condition="'@(_CreatedVsixContainer)' == '' and Exists('$(TargetVsixContainer)')">
      <_CreatedVsixContainer Include="$(TargetVsixContainer)" />
    </ItemGroup>
    <Error Condition="'$(DeployExtension)' == 'true' and '@(_CreatedVsixContainer)' == ''"
           Text="VSIX was not produced at $(TargetVsixContainer). F5 Exp deploy cannot continue." />
  </Target>

  <!-- SDK-style BuildDependsOn ignores VSSDK's CreateVsixContainer/Deploy hooks — force them after Build. -->
  <Target Name="IncludeVsixInBuild"
          AfterTargets="Build"
          DependsOnTargets="MergeCtoResource;GeneratePkgDef;CopyPkgDef;CreateVsixContainer;DeployVsixExtensionFiles"
          Condition="'$(CreateVsixContainer)'=='true'" />

  <!-- NuGet BuildTools sets VSToolsPath; this import enables CreateVsixContainer + F5 Exp deploy. -->
  <Import Project="$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets" Condition="'$(VSToolsPath)' != '' and Exists('$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets')" />
</Project>
