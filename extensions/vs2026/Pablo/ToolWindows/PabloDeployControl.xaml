<UserControl x:Class="Pablo.VisualStudio.ToolWindows.PabloDeployControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="280"
             MinHeight="200">
  <Grid x:Name="RootGrid" Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               x:Name="StatusText"
               TextWrapping="Wrap"
               Margin="0,0,0,8" />

    <TextBlock Grid.Row="1" x:Name="ManifestLabel" Text="Manifest" Margin="0,0,0,4" />
    <TextBlock Grid.Row="2"
               x:Name="ManifestText"
               TextWrapping="Wrap"
               Margin="0,0,0,12"
               FontWeight="SemiBold" />

    <TextBlock Grid.Row="3" x:Name="ProfileLabel" Text="Profile" Margin="0,0,0,4" />
    <ComboBox Grid.Row="4"
              x:Name="ProfileCombo"
              DisplayMemberPath="Name"
              Margin="0,0,0,12"
              MinHeight="28" />

    <StackPanel Grid.Row="5">
      <TextBlock x:Name="EnvironmentLabel" Text="Environment" Margin="0,0,0,4" />
      <ComboBox x:Name="EnvironmentCombo"
                Margin="0,0,0,12"
                MinHeight="28" />

      <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
        <Button x:Name="RunButton"
                Content="Run Deployment"
                MinWidth="140"
                MinHeight="28"
                Margin="0,0,8,0"
                IsEnabled="False" />
        <Button x:Name="RefreshButton"
                Content="Refresh"
                MinWidth="80"
                MinHeight="28" />
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>
